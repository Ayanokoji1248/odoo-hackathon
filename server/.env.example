DATABASE_URL=postgresql+asyncpg://globetrotter:globetrotter@localhost:5433/globetrotter
JWT_SECRET=change-me-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true

# Optional - defaults shown
# ACCESS_TOKEN_EXPIRE_MINUTES=15
# SESSION_EXPIRE_DAYS=30
# RESET_TOKEN_EXPIRE_MINUTES=30
# SQL_ECHO=false   # true logs every statement - very noisy

# Cookie policy. Local http needs COOKIE_SECURE=false; production must be true.
# A frontend on a different domain than the API needs COOKIE_SAMESITE=none (+ secure)
# - and that is the one case where this app would need a CSRF token added back.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=
